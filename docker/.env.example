# Copy to .env next to docker-compose.yml.

# Address players reach this server at (hostname or IP).
LMOXIDE_PUBLIC_HOST=lmo.example.org
LMOXIDE_SERVER_NAME=LMOxide

# Extracted clients on the host ("LEGO Minifigures Online" folders), mounted read-only.
LMOXIDE_WINDOWS_CLIENT=/srv/lmo/clients/windows/LEGO Minifigures Online
LMOXIDE_LINUX_CLIENT=/srv/lmo/clients/linux/LEGO Minifigures Online

# Fetch RDB files missing from the archived client from Funcom's patch server (empty: off).
LMOXIDE_UPSTREAM=http://update.lego.funcom.com/legoupm

# LAN conveniences; keep both off on a public server.
LMOXIDE_AUTO_REGISTER=false
LMOXIDE_DEFAULT_GM_LEVEL=0

# API
LMOXIDE_API_CORS_ORIGINS=
LMOXIDE_API_OPEN_REGISTRATION=false
LMOXIDE_API_TRUST_FORWARDED_FOR=false
