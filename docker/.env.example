# Settings for docker-compose.yml. Copy to .env next to docker-compose.yml and adjust.

# The host name players and browsers use: a DNS record pointing at this machine. Caddy gets its
# certificate. Also set it as public_host (and in api-url, website) in docker/lmoxide.toml.
LMOXIDE_PUBLIC_HOST=lmo.example.org

# Your copies of the game client, extracted ("LEGO Minifigures Online" folders; LMOxide doesn't
# ship them). The patch server builds player installs from them. Mounted read-only.
LMOXIDE_WINDOWS_CLIENT=/srv/lmo/clients/windows/LEGO Minifigures Online
LMOXIDE_LINUX_CLIENT=/srv/lmo/clients/linux/LEGO Minifigures Online

# Builds of the GUI patcher offered to players' patchers as a self-update (docs/HOSTING.md).
LMOXIDE_PATCHER_DIR=./patchers

# Image versions: latest, or a release such as 0.2.0 (without the v).
LMOXIDE_VERSION=latest
LMOXIDE_WEBUI_VERSION=latest
LMOXIDE_DEV_UI_VERSION=latest
LMOXIDE_DISCORD_BOT_VERSION=latest

# Log level: error, warn, info, debug, or per module (info,lmoxide_server=debug).
RUST_LOG=info

# Turn on the Discord bot (docker/discord-bot.toml, secrets/discord_token, secrets/discord_bot_key).
# COMPOSE_PROFILES=discord
