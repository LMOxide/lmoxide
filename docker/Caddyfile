# Caddy in front of everything on the HTTP side, one host name (LMOXIDE_PUBLIC_HOST), certificates
# from Let's Encrypt (automatic). docs/HOSTING.md has the layout.
#
#   /api/...                 the REST API (lmoxide, /api stripped)
#   /control/, /patch/, /auth/, /track, /rest/, /lmoxide/, /client-kit.tar.gz
#                            the patch server (lmoxide); also on plain HTTP, port 80
#   /dev/                    the dev UI (debugger, world editor)
#   everything else          the web UI
#
# The game ports (universe 7100/7103/7104, territory 7101, game 7102, chat 7200) are raw TCP:
# docker-compose.yml publishes them from the lmoxide container directly.

(patch_server) {
	@patch path /control/* /patch/* /auth/* /track /rest/* /lmoxide/* /client-kit.tar.gz
	handle @patch {
		reverse_proxy lmoxide:8080
	}
}

# The game client speaks only plain HTTP to the patch server (LocalConfig.xml, client files, the
# login page, the chat filter): its paths stay on port 80. Everything else goes to HTTPS.
http://{$LMOXIDE_PUBLIC_HOST} {
	import patch_server
	handle {
		redir https://{host}{uri} 308
	}
}

{$LMOXIDE_PUBLIC_HOST} {
	encode zstd gzip
	import patch_server

	handle_path /api/* {
		reverse_proxy lmoxide:8080
	}

	# the dev UI's pages use relative paths: they need the trailing slash
	redir /dev /dev/ 308
	@dev_page path_regexp ^/dev/(debugger|editor)$
	redir @dev_page {path}/ 308
	handle_path /dev/* {
		reverse_proxy dev-ui:8080
	}

	handle {
		reverse_proxy webui:8080
	}
}
