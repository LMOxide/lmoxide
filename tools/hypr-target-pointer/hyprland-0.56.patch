+// A pointer transaction runs as timed steps on the event loop. Clients such as XWayland drop
+// button events that arrive in the same burst as the enter and the leave that restores the
+// physical pointer focus, so the steps are spaced out and the focus is restored at the end.
+struct Step {
+    int                   delayMs;
+    std::function<void()> fn;
+};
+
+struct Transaction {
+    std::vector<Step>      steps;
+    size_t                 next = 0;
+    SP<CWLSurfaceResource> target;
+    SP<CWLSurfaceResource> restoreSurface;
+    Vector2D               restoreLocal;
+};
+
+std::optional<Transaction> g_transaction;
+SP<CEventLoopTimer>        g_timer;
+std::string                g_trace;
+
+uint32_t                   nowMs() {
+    return static_cast<uint32_t>(Time::millis(Time::steadyNow()));
+}
+
+void frame() {
+    g_pSeatManager->sendPointerFrame();
+    // Timer callbacks don't flush client buffers; without this every step leaves in one burst.
+    wl_display_flush_clients(g_pCompositor->m_wlDisplay);
+}
+
+void runSteps(SP<CEventLoopTimer>, void*) {
+    if (!g_transaction) return;
+    auto& tx = *g_transaction;
+    // The physical pointer moved to another surface meanwhile: stop, the seat already follows it.
+    if (tx.next > 1 && g_pSeatManager->m_state.pointerFocus.lock() != tx.target) {
+        g_trace += std::format(" aborted@{}", tx.next);
+        g_transaction.reset();
+        return;
+    }
+    while (tx.next < tx.steps.size()) {
+        g_trace += std::format(" s{}", tx.next);
+        tx.steps[tx.next++].fn();
+        if (tx.next < tx.steps.size() && tx.steps[tx.next].delayMs > 0) {
+            g_timer->updateTimeout(std::chrono::milliseconds(tx.steps[tx.next].delayMs));
+            return;
+        }
+    }
+    if (g_pSeatManager->m_state.pointerFocus.lock() == tx.target) {
+        g_pSeatManager->setPointerFocus(tx.restoreSurface, tx.restoreLocal);
+        if (tx.restoreSurface) {
+            g_pSeatManager->sendPointerMotion(nowMs(), tx.restoreLocal);
+            frame();
+        }
+    }
+    g_transaction.reset();
+}
