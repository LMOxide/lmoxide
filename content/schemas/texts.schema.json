{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`texts.json`: the client's dialogue texts and answers.",
  "properties": {
    "answers": {
      "additionalProperties": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "description": "Text id -> the answer text id.",
      "type": "object"
    },
    "keys": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Client text keys (\"category/id\" -> key).",
      "type": "object"
    },
    "names": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Name text id -> name.",
      "type": "object"
    },
    "texts": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Text id -> text.",
      "type": "object"
    }
  },
  "required": ["texts", "answers", "keys", "names"],
  "title": "Texts",
  "type": "object"
}
