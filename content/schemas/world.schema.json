{
  "$defs": {
    "LevelRange": {
      "additionalProperties": false,
      "properties": {
        "cap": {
          "description": "Players fight at most at this level here.",
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "max": {
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "min": {
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        }
      },
      "type": "object"
    },
    "NpcFights": {
      "additionalProperties": false,
      "description": "NPC-against-NPC fights set up in a world (npc.rs `Kind::Fighter`): the spawns marked `fight`\ntake part.",
      "properties": {
        "about": {
          "type": "string"
        },
        "armed_npcs": {
          "description": "NPC names that fight the world's enemies.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "replace_anchors": {
          "description": "Proposed enemies anchored at these areas are replaced by the fight.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rivals": {
          "description": "Sides by look (monster data): each group fights the other groups.",
          "items": {
            "items": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "rivals_about": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A point with a facing.",
      "properties": {
        "pos": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "rot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["pos"],
      "type": "object"
    },
    "RespawnPoint": {
      "additionalProperties": false,
      "properties": {
        "discoverable": {
          "type": ["boolean", "null"]
        },
        "guid": {
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "name": {
          "type": "string"
        },
        "pos": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "restoration": {
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "rot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rot"
            },
            {
              "type": "null"
            }
          ]
        },
        "shady": {
          "type": ["boolean", "null"]
        }
      },
      "required": ["name", "pos"],
      "type": "object"
    },
    "Rot": {
      "anyOf": [
        {
          "format": "float",
          "type": "number"
        },
        {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ],
      "description": "Which way something faces: a heading (radians about the up axis) or a quaternion\n`[x, y, z, w]` as the client stores it."
    },
    "Source": {
      "description": "Where a value came from, so guesses stay visible next to what live did.",
      "oneOf": [
        {
          "const": "client",
          "description": "Extracted from the game client's data.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Seen in a capture of the live server (LMO_Captures.cap).",
          "type": "string"
        },
        {
          "const": "demo",
          "description": "Seen in the recorded 2015 demo session.",
          "type": "string"
        },
        {
          "const": "footage",
          "description": "Taken from video footage of live.",
          "type": "string"
        },
        {
          "const": "server",
          "description": "Values the server used before they were moved into content (docs/TUNABLES.md).",
          "type": "string"
        },
        {
          "const": "proposed",
          "description": "Proposed by a tool from client data (navmesh, names, ...), not seen live.",
          "type": "string"
        },
        {
          "const": "surveyed",
          "description": "Placed or confirmed by someone in the world editor.",
          "type": "string"
        },
        {
          "const": "guess",
          "description": "A plain guess.",
          "type": "string"
        }
      ]
    },
    "WorldKind": {
      "oneOf": [
        {
          "const": "open",
          "description": "A world players share and come back to (enemies respawn).",
          "type": "string"
        },
        {
          "const": "pocket",
          "description": "An adventure or side dungeon: its encounters run once per visit, nothing respawns while\nsomeone is there.",
          "type": "string"
        },
        {
          "const": "hub",
          "description": "A hub (LEGO Center).",
          "type": "string"
        },
        {
          "const": "instance",
          "description": "Made per group on entry (Lost Creations levels).",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Development, PvP and asset test playfields.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A playfield: `worlds/<playfield>-<slug>/world.json`.",
  "properties": {
    "arrival": {
      "anyOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "type": "null"
        }
      ],
      "description": "Where teleports arrive (a resurrection point of the client's data)."
    },
    "arrival_from": {
      "additionalProperties": {
        "$ref": "#/$defs/Point"
      },
      "description": "Arrival when coming back from another world (`world/...` -> point).",
      "type": "object"
    },
    "arrival_guid": {
      "description": "The client's resurrection point guid of `arrival`.",
      "format": "uint32",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "arrival_mode": {
      "description": "How arrival is placed when there is no point (`navmesh`, ...).",
      "type": ["string", "null"]
    },
    "author": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "display_name": {
      "description": "The name the client shows (TDB 52000), when it differs from `name`.",
      "type": ["string", "null"]
    },
    "extends": {
      "description": "Another record of the same kind this one starts from: its fields, then this one's on top.",
      "type": ["string", "null"]
    },
    "feature": {
      "description": "The feature it belongs to: `live` (recreating live), `feature/...` or `other/...`.\nA record with the id of one in a parent feature changes it while this feature is on.",
      "type": "string"
    },
    "id": {
      "description": "Its id: `world/<slug>`. Stable: other records refer to it.",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/WorldKind",
      "default": "other"
    },
    "level": {
      "anyOf": [
        {
          "$ref": "#/$defs/LevelRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "music": {
      "description": "Music tracks (client ids).",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "npc_fights": {
      "anyOf": [
        {
          "$ref": "#/$defs/NpcFights"
        },
        {
          "type": "null"
        }
      ]
    },
    "playfield": {
      "description": "The client's playfield id.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "region": {
      "description": "The region it belongs to (`region/...`): which minifigures drop here.",
      "type": ["string", "null"]
    },
    "respawn_points": {
      "items": {
        "$ref": "#/$defs/RespawnPoint"
      },
      "type": "array"
    },
    "rev": {
      "description": "Revision, raised by every saved edit (for merging concurrent edits).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "description": "Labels for sorting work out (\"approximate\", \"todo\", \"verified\", ...).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "updated": {
      "description": "Unix time of the last edit.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "window": {
      "description": "The client teleport window that leads here.",
      "format": "uint32",
      "minimum": 0,
      "type": ["integer", "null"]
    }
  },
  "required": ["id", "playfield"],
  "title": "World",
  "type": "object"
}
