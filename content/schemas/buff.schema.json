{
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "spawn": {
              "additionalProperties": false,
              "properties": {
                "at": {
                  "$ref": "#/$defs/SpawnAt",
                  "default": "on_self"
                },
                "count": {
                  "default": 1,
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "lifetime": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Duration"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Gone after this long."
                },
                "overrides": {
                  "description": "Partial template fields for these spawns."
                },
                "radius": {
                  "description": "Spread around the spawn point (m).",
                  "format": "float",
                  "type": ["number", "null"]
                },
                "template": {
                  "description": "`npc/...` or `object/...`.",
                  "type": "string"
                }
              },
              "required": ["template"],
              "type": "object"
            }
          },
          "required": ["spawn"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "despawn": {
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "#/$defs/Target"
                }
              },
              "type": "object"
            }
          },
          "required": ["despawn"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "damage": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "description": "A fixed amount instead.",
                  "format": "float",
                  "type": ["number", "null"]
                },
                "mod": {
                  "description": "Share of the attacker's power (the client's AbilityMod).",
                  "format": "float",
                  "type": ["number", "null"]
                },
                "radius": {
                  "format": "float",
                  "type": ["number", "null"]
                },
                "target": {
                  "$ref": "#/$defs/Target"
                },
                "type": {
                  "description": "Damage type: `normal`, `fire`, ... or a client damage type number."
                }
              },
              "type": "object"
            }
          },
          "required": ["damage"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "heal": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "$ref": "#/$defs/Ratio",
                  "description": "Share of maximum health."
                },
                "target": {
                  "$ref": "#/$defs/Target"
                }
              },
              "required": ["amount"],
              "type": "object"
            }
          },
          "required": ["heal"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "apply_buff": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "description": "Overrides the buff's own `amount`."
                },
                "buff": {
                  "type": "string"
                },
                "duration": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Duration"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stacks": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": ["integer", "null"]
                },
                "target": {
                  "$ref": "#/$defs/Target"
                }
              },
              "required": ["buff"],
              "type": "object"
            }
          },
          "required": ["apply_buff"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "remove_buff": {
              "additionalProperties": false,
              "properties": {
                "buff": {
                  "type": "string"
                },
                "target": {
                  "$ref": "#/$defs/Target"
                }
              },
              "required": ["buff"],
              "type": "object"
            }
          },
          "required": ["remove_buff"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "knockback": {
              "additionalProperties": false,
              "properties": {
                "distance": {
                  "format": "float",
                  "type": "number"
                },
                "radius": {
                  "format": "float",
                  "type": ["number", "null"]
                },
                "target": {
                  "$ref": "#/$defs/Target"
                }
              },
              "required": ["distance"],
              "type": "object"
            }
          },
          "required": ["knockback"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Shows a client effect package.",
          "properties": {
            "effect": {
              "additionalProperties": false,
              "properties": {
                "effect_package": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "target": {
                  "$ref": "#/$defs/Target"
                }
              },
              "required": ["effect_package"],
              "type": "object"
            }
          },
          "required": ["effect"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "teleport": {
              "additionalProperties": false,
              "properties": {
                "to": {
                  "$ref": "#/$defs/Destination"
                }
              },
              "required": ["to"],
              "type": "object"
            }
          },
          "required": ["teleport"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Opens a client teleport window.",
          "properties": {
            "open_window": {
              "additionalProperties": false,
              "properties": {
                "window": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": ["window"],
              "type": "object"
            }
          },
          "required": ["open_window"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dialogue": {
              "additionalProperties": false,
              "properties": {
                "dialogue": {
                  "type": "string"
                }
              },
              "required": ["dialogue"],
              "type": "object"
            }
          },
          "required": ["dialogue"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "message": {
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": ["text"],
              "type": "object"
            }
          },
          "required": ["message"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "music": {
              "additionalProperties": false,
              "properties": {
                "track": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": ["track"],
              "type": "object"
            }
          },
          "required": ["music"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Changes an object's state (doors and gates `open`/`closed`, levers, buildies `built`).",
          "properties": {
            "set_state": {
              "additionalProperties": false,
              "properties": {
                "state": {
                  "type": "string"
                },
                "target": {
                  "$ref": "#/$defs/Target"
                }
              },
              "required": ["target", "state"],
              "type": "object"
            }
          },
          "required": ["set_state"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "start_script": {
              "additionalProperties": false,
              "properties": {
                "script": {
                  "type": "string"
                },
                "wave": {
                  "type": ["string", "null"]
                }
              },
              "required": ["script"],
              "type": "object"
            }
          },
          "required": ["start_script"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "end_script": {
              "additionalProperties": false,
              "properties": {
                "script": {
                  "type": "string"
                }
              },
              "required": ["script"],
              "type": "object"
            }
          },
          "required": ["end_script"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Counts a location as found (an exploration area's name), for its achievements.",
          "properties": {
            "discover": {
              "additionalProperties": false,
              "properties": {
                "achievement": {
                  "type": ["string", "null"]
                },
                "location": {
                  "type": ["string", "null"]
                }
              },
              "type": "object"
            }
          },
          "required": ["discover"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "grant_achievement": {
              "additionalProperties": false,
              "properties": {
                "achievement": {
                  "type": "string"
                }
              },
              "required": ["achievement"],
              "type": "object"
            }
          },
          "required": ["grant_achievement"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One collectible: a collect achievement (`achievement/...`) or a `drop:<name>` key.",
          "properties": {
            "collect": {
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                }
              },
              "required": ["key"],
              "type": "object"
            }
          },
          "required": ["collect"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Rolls a loot table where the owner is.",
          "properties": {
            "drop": {
              "additionalProperties": false,
              "properties": {
                "loot": {
                  "type": "string"
                }
              },
              "required": ["loot"],
              "type": "object"
            }
          },
          "required": ["drop"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "give_item": {
              "additionalProperties": false,
              "properties": {
                "count": {
                  "default": 1,
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "item": {
                  "type": "string"
                }
              },
              "required": ["item"],
              "type": "object"
            }
          },
          "required": ["give_item"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cinematic": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "type": "object"
            }
          },
          "required": ["cinematic"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A server command with arguments (the server lists what it knows).",
          "properties": {
            "command": {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "type": "object"
            }
          },
          "required": ["command"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Not known yet: what it should do goes in `comment`.",
          "properties": {
            "other": {
              "additionalProperties": false,
              "properties": {
                "comment": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "required": ["other"],
          "type": "object"
        }
      ]
    },
    "BuffEffect": {
      "description": "What a buff does while it's on.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Changes a stat. `stat`: a name the server knows (`damage`, `defense`, `max_health`,\n`move_speed`, `build_speed`, `special_recharge`, `normal_recharge`, `health_regen`,\n`mitigation`, `orb_chance`, ...) or a client stat name or number. `value`: a number,\n`\"20%\"`, or `\"amount\"` / `\"amount * 0.5\"` (the buff's amount, or the caller's).",
          "properties": {
            "stat": {
              "additionalProperties": false,
              "properties": {
                "op": {
                  "$ref": "#/$defs/StatOp",
                  "default": "add"
                },
                "stat": true,
                "value": true
              },
              "required": ["stat", "value"],
              "type": "object"
            }
          },
          "required": ["stat"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Deals its holder's damage as this type (elemental damage).",
          "properties": {
            "damage_type": true
          },
          "required": ["damage_type"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "proc": {
              "$ref": "#/$defs/Proc"
            }
          },
          "required": ["proc"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Changes a skill of its holder (`normal`, `special` or `skill/...`): more projectiles,\nfaster recharge, ...",
          "properties": {
            "skill_mod": {
              "additionalProperties": false,
              "properties": {
                "ability_mod": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Ratio"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cooldown": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Ratio"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "projectiles": {
                  "format": "int32",
                  "type": ["integer", "null"]
                },
                "skill": {
                  "type": "string"
                }
              },
              "required": ["skill"],
              "type": "object"
            }
          },
          "required": ["skill_mod"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Replaces a shortcut's skill while on (stances, combos: OverrideShortcut).",
          "properties": {
            "override": {
              "additionalProperties": false,
              "properties": {
                "skill": {
                  "type": "string"
                },
                "slot": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": ["slot", "skill"],
              "type": "object"
            }
          },
          "required": ["override"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A client game action as the client's data has it.",
          "properties": {
            "client": {
              "$ref": "#/$defs/GameAction"
            }
          },
          "required": ["client"],
          "type": "object"
        }
      ]
    },
    "Destination": {
      "additionalProperties": false,
      "description": "Where a portal, trigger or teleport takes a player.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "type": "object"
        },
        "command": {
          "description": "A server command instead of a place, e.g. `lost_creations.advance` (the server lists its\ncommands and their arguments).",
          "type": ["string", "null"]
        },
        "point": {
          "description": "A named arrival point of that world (`arrival_from` key or respawn point name).",
          "type": ["string", "null"]
        },
        "pos": {
          "description": "An exact position (instead of a point).",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": ["array", "null"]
        },
        "prompt": {
          "description": "Ask first (\"Do you want to travel to X?\").",
          "type": ["string", "null"]
        },
        "world": {
          "description": "The world (`world/...`); none: the same world.",
          "type": ["string", "null"]
        }
      },
      "type": "object"
    },
    "Duration": {
      "anyOf": [
        {
          "pattern": "^\\s*-?[0-9.]+\\s*(ms|s|m|h)?\\s*$",
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "A length of time: \"1.5s\", \"200ms\", \"2m\", \"1h\", or a number of seconds"
    },
    "GameAction": {
      "additionalProperties": false,
      "description": "A client game action as the client's data writes it (`type` and its arguments). Numbers in\n`args` are client ids (nanos, items, effect packages).",
      "properties": {
        "args": {
          "additionalProperties": true,
          "type": "object"
        },
        "client": {
          "description": "Run by the client itself (the server doesn't need to).",
          "type": "boolean"
        },
        "criteria": {
          "description": "When it runs: the client's criteria, `[list, value, operator]` each (e.g. `[0, 448001,\n101]`: the caster has upgrade 448001; 91: hasn't).",
          "items": true,
          "type": "array"
        },
        "type": {
          "type": "string"
        }
      },
      "required": ["type"],
      "type": "object"
    },
    "Proc": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "below": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ratio"
            },
            {
              "type": "null"
            }
          ]
        },
        "chance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ratio"
            },
            {
              "type": "null"
            }
          ]
        },
        "channelling": {
          "description": "Only while the holder channels a special.",
          "type": "boolean"
        },
        "every": {
          "description": "Every nth time.",
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "every_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "lockout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Can't go off again for this long."
        },
        "on": {
          "$ref": "#/$defs/ProcOn"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "type": "array"
        }
      },
      "required": ["on", "then"],
      "type": "object"
    },
    "ProcOn": {
      "description": "When a proc goes off.",
      "oneOf": [
        {
          "enum": ["normal_hit", "special_hit", "normal_attack", "special_attack", "special_kill"],
          "type": "string"
        },
        {
          "const": "hit",
          "description": "Any attack of its holder hits.",
          "type": "string"
        },
        {
          "const": "attack",
          "description": "The holder attacks (hit or not).",
          "type": "string"
        },
        {
          "const": "damaged",
          "description": "The holder is hit.",
          "type": "string"
        },
        {
          "const": "kill",
          "description": "The holder smashes an enemy.",
          "type": "string"
        },
        {
          "const": "health_below",
          "description": "The holder's health drops below `below`.",
          "type": "string"
        },
        {
          "const": "not_hit_for",
          "description": "The holder hasn't been hit for `after`.",
          "type": "string"
        },
        {
          "const": "interval",
          "description": "Every `every_time`.",
          "type": "string"
        },
        {
          "const": "smash",
          "description": "The holder smashes a smashable.",
          "type": "string"
        },
        {
          "const": "build",
          "description": "The holder builds a buildie.",
          "type": "string"
        }
      ]
    },
    "Ratio": {
      "anyOf": [
        {
          "pattern": "^\\s*-?[0-9.]+\\s*%\\s*$",
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "A share: \"20%\" or a fraction (0.2)"
    },
    "Source": {
      "description": "Where a value came from, so guesses stay visible next to what live did.",
      "oneOf": [
        {
          "const": "client",
          "description": "Extracted from the game client's data.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Seen in a capture of the live server (LMO_Captures.cap).",
          "type": "string"
        },
        {
          "const": "demo",
          "description": "Seen in the recorded 2015 demo session.",
          "type": "string"
        },
        {
          "const": "footage",
          "description": "Taken from video footage of live.",
          "type": "string"
        },
        {
          "const": "server",
          "description": "Values the server used before they were moved into content (docs/TUNABLES.md).",
          "type": "string"
        },
        {
          "const": "proposed",
          "description": "Proposed by a tool from client data (navmesh, names, ...), not seen live.",
          "type": "string"
        },
        {
          "const": "surveyed",
          "description": "Placed or confirmed by someone in the world editor.",
          "type": "string"
        },
        {
          "const": "guess",
          "description": "A plain guess.",
          "type": "string"
        }
      ]
    },
    "SpawnAt": {
      "description": "Where spawned things appear.",
      "oneOf": [
        {
          "enum": ["on_self", "on_target", "around_self", "around_target"],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A random point in an area (`area/...`).",
          "properties": {
            "in_area": {
              "type": "string"
            }
          },
          "required": ["in_area"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "items": {
                "format": "float",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            }
          },
          "required": ["at"],
          "type": "object"
        }
      ]
    },
    "Stacking": {
      "oneOf": [
        {
          "enum": ["stack", "replace"],
          "type": "string"
        },
        {
          "const": "refresh",
          "description": "Again: the time starts over.",
          "type": "string"
        },
        {
          "const": "ignore",
          "description": "Again: nothing happens.",
          "type": "string"
        }
      ]
    },
    "StatOp": {
      "description": "How a stat changes.",
      "oneOf": [
        {
          "const": "add",
          "description": "Adds the value.",
          "type": "string"
        },
        {
          "const": "mul",
          "description": "Multiplies by (1 + value).",
          "type": "string"
        },
        {
          "const": "set",
          "description": "Sets the value.",
          "type": "string"
        }
      ]
    },
    "Target": {
      "description": "Who or what an action acts on. Default: whoever the action's owner aims at (the skill's\ntarget, the player who set the trigger off, the defeated enemy ...).",
      "oneOf": [
        {
          "const": "target",
          "description": "The action's own target (default).",
          "type": "string"
        },
        {
          "const": "self",
          "description": "Whoever owns the action (the caster, the buff's holder, the trigger, the object).",
          "type": "string"
        },
        {
          "const": "trigger_player",
          "description": "The player who set it off (triggers, scripts).",
          "type": "string"
        },
        {
          "const": "team",
          "description": "The player's team on the same playfield.",
          "type": "string"
        },
        {
          "const": "all_in_area",
          "description": "Everyone in the area of the trigger or script.",
          "type": "string"
