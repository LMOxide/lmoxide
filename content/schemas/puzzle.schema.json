{
  "$defs": {
    "Beam": {
      "additionalProperties": false,
      "properties": {
        "length": {
          "format": "float",
          "type": "number"
        },
        "pos": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "rot": {
          "$ref": "#/$defs/Rot"
        }
      },
      "required": ["pos", "rot", "length"],
      "type": "object"
    },
    "LightGateMirror": {
      "additionalProperties": false,
      "description": "A gate opened by light reaching it through mirrors (gates.rs).",
      "properties": {
        "guid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "length": {
          "format": "float",
          "type": "number"
        },
        "light": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "pos": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "rot": {
          "$ref": "#/$defs/Rot"
        }
      },
      "required": ["guid", "pos", "light", "rot", "length"],
      "type": "object"
    },
    "Mirror": {
      "additionalProperties": false,
      "description": "Mirrors reflecting a beam onto a target (mirrors.rs).",
      "properties": {
        "beam": {
          "additionalProperties": {
            "$ref": "#/$defs/Beam"
          },
          "type": "object"
        },
        "guid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "out": {
          "additionalProperties": {
            "type": ["string", "null"]
          },
          "description": "The mirror each turn sends the beam to (`plus`/`minus`; none: nowhere).",
          "type": "object"
        },
        "pos": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": ["guid", "name", "pos", "out", "beam"],
      "type": "object"
    },
    "NamedPos": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "pos": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": ["name", "pos"],
      "type": "object"
    },
    "PuzzleKind": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mirrors": {
              "additionalProperties": false,
              "properties": {
                "mirrors": {
                  "items": {
                    "$ref": "#/$defs/Mirror"
                  },
                  "type": "array"
                },
                "opens": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "roots": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "targets": {
                  "items": {
                    "$ref": "#/$defs/NamedPos"
                  },
                  "type": "array"
                }
              },
              "required": ["mirrors", "roots", "targets", "opens"],
              "type": "object"
            }
          },
          "required": ["mirrors"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "light_gate": {
              "additionalProperties": false,
              "properties": {
                "gate": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "mirrors": {
                  "items": {
                    "$ref": "#/$defs/LightGateMirror"
                  },
                  "type": "array"
                },
                "pos": {
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                }
              },
              "required": ["gate", "pos", "mirrors"],
              "type": "object"
            }
          },
          "required": ["light_gate"],
          "type": "object"
        }
      ]
    },
    "Rot": {
      "anyOf": [
        {
          "format": "float",
          "type": "number"
        },
        {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ],
      "description": "Which way something faces: a heading (radians about the up axis) or a quaternion\n`[x, y, z, w]` as the client stores it."
    },
    "Source": {
      "description": "Where a value came from, so guesses stay visible next to what live did.",
      "oneOf": [
        {
          "const": "client",
          "description": "Extracted from the game client's data.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Seen in a capture of the live server (LMO_Captures.cap).",
          "type": "string"
        },
        {
          "const": "demo",
          "description": "Seen in the recorded 2015 demo session.",
          "type": "string"
        },
        {
          "const": "footage",
          "description": "Taken from video footage of live.",
          "type": "string"
        },
        {
          "const": "server",
          "description": "Values the server used before they were moved into content (docs/TUNABLES.md).",
          "type": "string"
        },
        {
          "const": "proposed",
          "description": "Proposed by a tool from client data (navmesh, names, ...), not seen live.",
          "type": "string"
        },
        {
          "const": "surveyed",
          "description": "Placed or confirmed by someone in the world editor.",
          "type": "string"
        },
        {
          "const": "guess",
          "description": "A plain guess.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A puzzle the server runs: `worlds/<world>/puzzles.json`.",
  "properties": {
    "author": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "extends": {
      "description": "Another record of the same kind this one starts from: its fields, then this one's on top.",
      "type": ["string", "null"]
    },
    "feature": {
      "description": "The feature it belongs to: `live` (recreating live), `feature/...` or `other/...`.\nA record with the id of one in a parent feature changes it while this feature is on.",
      "type": "string"
    },
    "id": {
      "description": "Its id: `puzzle/<slug>`. Stable: other records refer to it.",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "puzzle": {
      "$ref": "#/$defs/PuzzleKind"
    },
    "rev": {
      "description": "Revision, raised by every saved edit (for merging concurrent edits).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "description": "Labels for sorting work out (\"approximate\", \"todo\", \"verified\", ...).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "updated": {
      "description": "Unix time of the last edit.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": ["id", "puzzle"],
  "title": "Puzzle",
  "type": "object"
}
