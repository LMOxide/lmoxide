{
  "$defs": {
    "ChestInfo": {
      "additionalProperties": false,
      "properties": {
        "client_loot_table": {
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "loot": {
          "description": "What opening it gives.",
          "type": ["string", "null"]
        },
        "loot_type": {
          "description": "1 free, 2 members.",
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "lua_script": {
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "offset": true,
        "spawn_effect_package": {
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "unused": {
          "description": "Not dropped (the client's Endless chests).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "GameAction": {
      "additionalProperties": false,
      "description": "A client game action as the client's data writes it (`type` and its arguments). Numbers in\n`args` are client ids (nanos, items, effect packages).",
      "properties": {
        "args": {
          "additionalProperties": true,
          "type": "object"
        },
        "client": {
          "description": "Run by the client itself (the server doesn't need to).",
          "type": "boolean"
        },
        "criteria": {
          "description": "When it runs: the client's criteria, `[list, value, operator]` each (e.g. `[0, 448001,\n101]`: the caster has upgrade 448001; 91: hasn't).",
          "items": true,
          "type": "array"
        },
        "type": {
          "type": "string"
        }
      },
      "required": ["type"],
      "type": "object"
    },
    "ItemKind": {
      "oneOf": [
        {
          "enum": ["chest", "health_orb", "mission_item"],
          "type": "string"
        },
        {
          "const": "part",
          "description": "A minifigure part (head, torso, legs).",
          "type": "string"
        },
        {
          "const": "minifig_bag",
          "description": "A bag that unlocks a minifigure.",
          "type": "string"
        },
        {
          "const": "token",
          "description": "Stars, potions and other counters.",
          "type": "string"
        },
        {
          "const": "projectile",
          "description": "What a projectile is (visual and on-hit actions).",
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "Where a value came from, so guesses stay visible next to what live did.",
      "oneOf": [
        {
          "const": "client",
          "description": "Extracted from the game client's data.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Seen in a capture of the live server (LMO_Captures.cap).",
          "type": "string"
        },
        {
          "const": "demo",
          "description": "Seen in the recorded 2015 demo session.",
          "type": "string"
        },
        {
          "const": "footage",
          "description": "Taken from video footage of live.",
          "type": "string"
        },
        {
          "const": "server",
          "description": "Values the server used before they were moved into content (docs/TUNABLES.md).",
          "type": "string"
        },
        {
          "const": "proposed",
          "description": "Proposed by a tool from client data (navmesh, names, ...), not seen live.",
          "type": "string"
        },
        {
          "const": "surveyed",
          "description": "Placed or confirmed by someone in the world editor.",
          "type": "string"
        },
        {
          "const": "guess",
          "description": "A plain guess.",
          "type": "string"
        }
      ]
    },
    "TokenAmount": {
      "additionalProperties": false,
      "description": "A token an item adds to, and how much (negative: takes).",
      "properties": {
        "amount": {
          "format": "int64",
          "type": ["integer", "null"]
        },
        "token": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["token"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An item: `items/<slug>.json`.",
  "properties": {
    "actions": {
      "description": "Client game actions it runs (bags: what they spawn; projectiles: on hit).",
      "items": {
        "$ref": "#/$defs/GameAction"
      },
      "type": "array"
    },
    "author": {
      "type": "string"
    },
    "chest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChestInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "comment": {
      "type": "string"
    },
    "controlled_loot_type": {
      "description": "Bags: the client's ControlledLootType (3 regular, 4/5 tutorial).",
      "format": "uint32",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "dynel_type": {
      "format": "uint32",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "effect_package": {
      "format": "uint32",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "extends": {
      "description": "Another record of the same kind this one starts from: its fields, then this one's on top.",
      "type": ["string", "null"]
    },
    "feature": {
      "description": "The feature it belongs to: `live` (recreating live), `feature/...` or `other/...`.\nA record with the id of one in a parent feature changes it while this feature is on.",
      "type": "string"
    },
    "id": {
      "description": "Its id: `item/<slug>`. Stable: other records refer to it.",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ItemKind"
    },
    "location": {
      "description": "Parts: `Head`, `Torso`, `Legs`.",
      "type": ["string", "null"]
    },
    "minifigure": {
      "type": ["string", "null"]
    },
    "monster_data": {
      "format": "uint32",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "name": {
      "type": "string"
    },
    "radius": {
      "description": "Projectiles: hit radius (m).",
      "format": "float",
      "type": ["number", "null"]
    },
    "rev": {
      "description": "Revision, raised by every saved edit (for merging concurrent edits).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "description": "Labels for sorting work out (\"approximate\", \"todo\", \"verified\", ...).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "template": {
      "description": "The client item template.",
      "format": "uint32",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "tokens": {
      "description": "The tokens it adds to (stars, potions, part tokens ...).",
      "items": {
        "$ref": "#/$defs/TokenAmount"
      },
      "type": "array"
    },
    "updated": {
      "description": "Unix time of the last edit.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": ["id", "kind"],
  "title": "Item",
  "type": "object"
}
